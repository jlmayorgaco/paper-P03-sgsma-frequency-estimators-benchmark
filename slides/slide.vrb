\frametitle{Performance is measured inside the contract, not by the author}
\begin{columns}[T,onlytextwidth]
\column{0.50\linewidth}
\scriptsize
\begin{block}{The public \texttt{step()} wrapper instruments every call}
\begin{semiverbatim}\tiny
\textcolor{ofbViolet}{def} \textcolor{ofbBlue}{step}(self, z, t_s, memory):
    t0 = time.process\_time()
    y  = self.\_step(z, t_s, mem)     \textcolor{ofbMuted}{# author code}
    dt = time.process\_time() - t0

    self.\_times\_us.append(dt*1e6)    \textcolor{ofbMuted}{# CPU}
    \textcolor{ofbViolet}{if} \textcolor{ofbViolet}{not} isfinite(y):
        self.\_invalid += \textcolor{ofbRust}{1}        \textcolor{ofbMuted}{# NaN/Inf guard}
    mem.observe()                    \textcolor{ofbMuted}{# memory proxy}
    \textcolor{ofbViolet}{return} y
\end{semiverbatim}
\end{block}
\column{0.48\linewidth}
\scriptsize
\begin{block}{What the harness records per run, for free}
\begin{itemize}\setlength\itemsep{2.5pt}
  \item \textbf{M13 CPU} --- mean \texttt{process\_time} per sample ($\mu$s), wrapped around the author's code so it cannot be gamed.
  \item \textbf{M20 jitter} --- standard deviation of per-step time.
  \item \textbf{invalid-output rate} --- fraction of NaN/Inf returns (divergence detector).
  \item \textbf{startup-valid sample} --- when the first usable output appears.
  \item \textbf{memory proxy} --- peak/mean bytes via \texttt{MemoryStore}.
\end{itemize}
\end{block}
\end{columns}
\vspace{-0.1em}
\callout{Because the timing and validity instrumentation lives in the \emph{wrapper}, every estimator is measured identically --- the same anti-cheat path for a 7\,$\mu$s ZCD and a 15{,}000\,$\mu$s Koopman.}
